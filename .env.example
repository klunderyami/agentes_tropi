# ============================================================
# TROPICAÑA — AGENTES AUTÓNOMOS · PLANTILLA DE CREDENCIALES
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` al repositorio (agrégalo a .gitignore).
# ============================================================

# --- IA Generativa (Anthropic): orquesta a los 35 agentes ---
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Meta Graph API (cobertura global de campañas y publicaciones) ---
META_GRAPH_API_KEY=EAAGxxxxxxxxxxxxxxxx

# --- WhatsApp Business Cloud API (ventas y cierre directo) ---
WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_BUSINESS_ACCOUNT_ID=9876543210987654

# --- Supabase (CRM de leads / base operativa) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- ManyChat (bot de broadcast en WhatsApp/Instagram) ---
MANYCHAT_TOKEN=xxxx-xxxx-xxxx-xxxx

# --- Webhooks de automatización (n8n / Make) ---
N8N_WEBHOOK_URL=https://tu-instancia.app.n8n.cloud/webhook/lead-entry
MAKE_WEBHOOK_URL=https://hook.make.com/xxxxx

# --- Zonas activas (escasez y asignación territorial de lotes) ---
TROPI_ZONAS_ACTIVAS=Boca del Río,Veracruz Centro,Coatzacoalcos,Xalapa,Poza Rica